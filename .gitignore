# Dependencies
node_modules/
.pnpm-store/

# JavaScript build output
.next*/
.next-build/
dist/
out/
.turbo/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example

# Go binaries and test artifacts
/backend/server
/backend/bin/
/backend/tmp/
*.exe
*.test
*.out

# IDE and OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs and coverage
*.log
coverage/
.nyc_output/

# Terraform (state may contain secrets; .terraform.lock.hcl IS committed)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Rover output (plan JSON embeds state, secrets included)
**/.rover/
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Agent worktrees (checkouts of this same repo, never content of their own)
.claude/worktrees/

# Production snapshot pulled by `make prod-to-local`: a plaintext dump of the
# customer database plus every media object. Never commit any of it.
.prod-snapshot/

# Playwright
e2e/test-results/
e2e/playwright-report/
e2e/.e2e-state/
e2e/blob-report/
