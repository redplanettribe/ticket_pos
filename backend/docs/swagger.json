                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/platform.Envelope"
                        }
                    }
                }
            }
        },
        "/api/v1/staff/memberships": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
