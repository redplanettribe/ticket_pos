            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Destroys the authenticated session.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Logout",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
