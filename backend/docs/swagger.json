                "produces": [
                    "application/json"
                ],
                "tags": [
                    "staff"
                ],
                "summary": "List memberships",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/platform.Envelope"
                        }
                    }
                }
            }
