        "platform.APIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "details": {},
                "message": {
                    "type": "string"
                }
            }
        },
        "platform.Envelope": {
            "type": "object",
            "properties": {
                "data": {},
