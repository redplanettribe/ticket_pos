# Copy to .env and fill in. .env is gitignored; this file is committed as the
# reference. Only the values below are needed locally — DATABASE_URL and the S3_*
# settings are supplied by docker-compose for the dev stack.

# --- Email (Resend) -----------------------------------------------------------
# Local dev: the backend uses the logging email sender (OTP codes printed to the
# container log) whenever RESEND_API_KEY is empty. Set it to send real mail from
# the dev stack via Resend. Requires send.multiticketing.com verified in Resend,
# or sends fail with a 422. docker-compose reads these from this file.
RESEND_API_KEY=
# Quoted: the < > are shell redirection when this file is sourced for Terraform.
EMAIL_FROM='Multiticketing <noreply@send.multiticketing.com>'

# --- Confirmation Links -------------------------------------------------------
# The HMAC key every Confirmation Link in a Sale Confirmation is signed with.
# Leave it empty locally: the backend generates a random one per process and logs
# that it did, so links work within a run of the dev stack and stop working
# across a restart. Production is different — the API refuses to boot without
# this set, because signing with a fallback is the same as not signing at all.
# Terraform generates and stores the production value itself; nothing to set here.
CONFIRMATION_LINK_SECRET=

# --- Google Sign-In -----------------------------------------------------------
# Credentials from the `development` OAuth client in the `multiticketing` Google
# Cloud project (Console > APIs & Services > Credentials). ONE dev client is
# shared by both apps locally — the per-surface isolation that matters is a
# production property (ADR 0011) — and it carries both localhost redirect URIs:
#
#   http://localhost:64300/api/customer/auth/google/callback   (Storefront)
#   http://localhost:64301/api/auth/google/callback            (Staff)
#
# Google permits plain HTTP on localhost, so no TLS is needed for the dev stack.
# The registered URI must match what the app sends exactly — scheme, host, PORT
# and path — and these are the published ports from docker-compose, not the
# container ports 3000/3001.
#
# Leave them empty and everything except the Google button works: the button is
# hidden rather than broken, and passcode sign-in is unaffected. The backend
# needs the pair to exchange a code; each frontend needs the ID and its own
# redirect URI. No frontend ever gets a client secret in production — locally the
# same values are simply reused for both.
GOOGLE_STAFF_CLIENT_ID=
GOOGLE_STAFF_CLIENT_SECRET=
GOOGLE_STOREFRONT_CLIENT_ID=
GOOGLE_STOREFRONT_CLIENT_SECRET=

# GOOGLE_TOKEN_ENDPOINT is deliberately absent. It exists so integration tests
# can point the exchange at a stub, and the API refuses to boot with it set when
# APP_ENV is production: anyone who could point it elsewhere could make the
# platform trust an issuer they control. Do not add it here.

# --- PayPhone (online payments) -------------------------------------------------
# The platform's single PayPhone merchant account (ADR 0012): the Bearer token
# and store id from the PayPhone Developer portal (docs.payphone.app). Leave BOTH
# empty locally and the backend selects the stub Payment Provider — the full
# checkout works with zero setup, approving or declining from the Storefront's
# dev-only interstitial. Set both to charge through PayPhone instead: use the
# portal's SANDBOX credentials for testing (payments auto-approve, no money
# moves) and the production ones only in production, where they arrive as
# secrets. Half a pair still selects the stub.
PAYPHONE_API_TOKEN=
PAYPHONE_STORE_ID=

# PAYPHONE_API_BASE_URL is deliberately absent. It exists so integration tests
# can point Prepare/Confirm at a fake PayPhone server, and the API refuses to
# boot with it set when APP_ENV is production: anyone who could point it
# elsewhere could "approve" payments no one ever made. Do not add it here.

# --- Terraform ----------------------------------------------------------------
# The SAME Resend key, under the TF_VAR_ name Terraform expects, so a production
# apply writes it to Secret Manager. Terraform does not read this file on its
# own — source it first:  set -a; source .env; set +a
# Then: terraform -chdir=terraform/envs/prod apply
TF_VAR_resend_api_key=

# The PRODUCTION Google credentials — from the `staff` and `storefront` clients,
# NOT the development one above. A prod apply writes all four to Secret Manager
# and mounts them on the API. Applying without these sourced removes the secret
# versions and turns Google Sign-In off (issue #73 records the same trap for the
# Resend key), so source this file before every prod apply.
TF_VAR_google_staff_client_id=
TF_VAR_google_staff_client_secret=
TF_VAR_google_storefront_client_id=
TF_VAR_google_storefront_client_secret=
